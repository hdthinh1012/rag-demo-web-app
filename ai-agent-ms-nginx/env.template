# Environment Configuration for Nginx + AI Agent Setup
# Copy this file to .env and update with your values

# Google Cloud Configuration
PROJECT_ID=personal-rag-ai-agent
LOCATION=asia-southeast1

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Nginx Configuration
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# Load Balancing
# If you have multiple AI Agent instances, list them here
# AI_AGENT_SERVERS=ai-agent-1:5000,ai-agent-2:5000,ai-agent-3:5000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SSL Configuration (for HTTPS)
# SSL_CERTIFICATE_PATH=/path/to/certificate.crt
# SSL_PRIVATE_KEY_PATH=/path/to/private.key

# Monitoring
LOG_LEVEL=warn
ACCESS_LOG_FORMAT=main

# Important
IP_ADDRESS=<your-public-ip-address>
DOMAIN=<your-domain-name>